{
  "name": "public-domain-cinema",
  "version": "1.0.0",
  "private": true,
  "description": "聚合 Internet Archive 公有领域影视资源的合法播放站",
  "main": "desktop/main.mjs",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "icon": "node scripts/generate-icon.mjs",
    "prepare:pack": "node scripts/prepare-pack.mjs",
    "pack:win": "npm run icon && npm run build && npm run prepare:pack && electron-builder --win",
    "pack:portable": "npm run icon && npm run build && npm run prepare:pack && electron-builder --win portable",
    "pack:dir": "npm run icon && npm run build && npm run prepare:pack && electron-builder --win dir"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.publicdomain.cinema",
    "productName": "Public Domain Cinema",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*"
    ],
    "extraResources": [
      {
        "from": "pack/app",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.exe"
    }
  }
}
